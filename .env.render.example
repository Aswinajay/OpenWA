# =====================================================================
# OpenWA - Environment Configuration for Render Free Tier (512 MB RAM)
# Optimized for OUTBOUND-ONLY (Sending messages, alerts & notifications)
# =====================================================================
# Copy these environment variables to your Render Web Service dashboard
# under "Environment" -> "Environment Variables", or deploy via render.yaml.
# =====================================================================

# Server & Runtime (Micro-optimized V8 heap budget for low memory footprint)
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=256 --optimize-for-size
HOST=0.0.0.0
PORT=10000

# WhatsApp Engine (Baileys WebSocket, zero headless Chrome)
ENGINE_TYPE=baileys
SESSION_DATA_PATH=./data/sessions
AUTO_START_SESSIONS=true
PUPPETEER_SKIP_DOWNLOAD=true

# -------------------------------------------------------------------
# 🔥 MICRO-OPTIMIZATIONS FOR SEND-ONLY (NOT RECEIVING)
# -------------------------------------------------------------------
# 1. Drops all incoming messages instantly before parsing/allocating
OUTBOUND_ONLY=true

# 2. Disables downloading chat history & archive messages from WhatsApp
BAILEYS_SYNC_HISTORY=false
BAILEYS_SYNC_FULL_HISTORY=false

# 3. Disables downloading incoming media (audio, video, photos, docs)
MEDIA_DOWNLOAD_ENABLED=false

# 4. Suppress broadcasting 'online' status on connect (stops phone silence)
BAILEYS_MARK_ONLINE_ON_CONNECT=false

# 5. Shrinks LRU caches and message store limits (only keep what is needed for retry)
BAILEYS_MESSAGE_STORE_LIMIT=50
BAILEYS_SESSION_STORE_MAX_ENTRIES=100

# Database (Lightweight SQLite, no external server needed)
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=false

# Security (Master Admin API Key - must be 32+ characters in production)
# In Render, you can set this directly or let render.yaml generate it.
# API_MASTER_KEY=owa_k1_your_32_character_long_secret_key_here

# Turn off memory-heavy optional components
QUEUE_ENABLED=false
REDIS_ENABLED=false
CACHE_ENABLED=false
SEARCH_ENABLED=false
MCP_ENABLED=false

# Dashboard & Docs
SERVE_DASHBOARD=true
ENABLE_SWAGGER=false

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media
BODY_SIZE_LIMIT=15mb
