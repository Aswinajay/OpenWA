# OpenWA single-instance / Render Free send-only profile
# Render Free has ephemeral local storage, so SQLite/session files are not durable across restarts.
# Use this profile for lightweight testing/single-instance sending, not durable production persistence.

NODE_ENV=production
LIGHTWEIGHT_MODE=true
SEND_ONLY_MODE=true
PORT=2785

# One local SQLite data path.
DATABASE_TYPE=sqlite
DATABASE_NAME=./data/openwa.sqlite
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=false

# One browser-based WhatsApp engine.
ENGINE_TYPE=whatsapp-web.js
AUTO_START_SESSIONS=false
MAX_CONCURRENT_SESSIONS=1
SESSION_DATA_PATH=./data/sessions

# No external infrastructure in the lightweight runtime.
REDIS_ENABLED=false
QUEUE_ENABLED=false
CACHE_ENABLED=false
SEARCH_ENABLED=false
MCP_ENABLED=false

# Do not download/decrypt incoming media.
MEDIA_DOWNLOAD_ENABLED=false

# Local storage only for data explicitly produced by this API.
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./data/media

PUPPETEER_HEADLESS=true
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox,--disable-dev-shm-usage,--disable-gpu

WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000

# Optional: set a strong API key explicitly on Render.
# API_MASTER_KEY=replace-with-a-long-random-secret
